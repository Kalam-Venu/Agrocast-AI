# Supabase credentials (optional for full cloud sync; app includes offline demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Provider (Google Gemini). Server-side only; AI chat and image analysis are unavailable without a key.
# The app uses gemini-3.8-flash and does not provide generated offline agronomic advice.
GEMINI_API_KEY=

# Open-Meteo Weather API Base URL (free public API, no key required)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# data.gov.in AGMARKNET dataset (free developer API key)
DATA_GOV_IN_API_KEY=
